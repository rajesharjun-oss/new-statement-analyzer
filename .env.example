# Statement Analyzer Environment Variables
# Copy this file to .env and fill in your keys

# AI API keys are optional. Deterministic extraction and analysis run without them.
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
OPENAI_NARRATIVE_MODEL=gpt-4o-mini
ANTHROPIC_CLASSIFIER_MODEL=claude-3-haiku-20240307
ANTHROPIC_NARRATIVE_MODEL=claude-3-haiku-20240307

# OCR Engine (Options: gemini, openai)
OCR_ENGINE=gemini

# UBA long statement extraction limits
UBA_OCR_MAX_PAGES=80
UBA_AI_MAX_PAGES=30
WEMA_HEADER_SCAN_PAGES=12

# Optional: Set to true for strict bank template matching
STRICT_TEMPLATE_MODE=false

# API hardening
# Comma-separated browser origins allowed to call the API during local/dev use.
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
MAX_UPLOAD_BYTES=20971520
TEMP_FILE_TTL_SECONDS=3600
MAX_CLASSIFY_TRANSACTIONS=500
MAX_CLASSIFY_INSTRUCTIONS_CHARS=4000
MAX_NARRATIVE_PAYLOAD_CHARS=100000
MAX_AI_REQUEST_BYTES=1048576
RATE_LIMIT_WINDOW_SECONDS=60
ANALYZE_RATE_LIMIT=20
CLASSIFY_RATE_LIMIT=30
NARRATIVE_RATE_LIMIT=10
ENABLE_API_DOCS=false
DEBUG_ERRORS=false
