# Statement Analyzer Environment Variables
# Copy this file to .env and fill in your keys

# AI API Keys (REQUIRED)
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# OCR Engine (Options: gemini, openai)
OCR_ENGINE=gemini

# Optional: Set to true for strict bank template matching
STRICT_TEMPLATE_MODE=false

# API hardening
# Comma-separated browser origins allowed to call the API during local/dev use.
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
MAX_UPLOAD_BYTES=20971520
TEMP_FILE_TTL_SECONDS=3600
MAX_CLASSIFY_TRANSACTIONS=500
MAX_CLASSIFY_INSTRUCTIONS_CHARS=4000
ENABLE_API_DOCS=false
DEBUG_ERRORS=false
